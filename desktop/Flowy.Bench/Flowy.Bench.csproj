<Project Sdk="Microsoft.NET.Sdk">
  <!-- Times the desktop core on big generated folders. Run it with: dotnet run -c Release (project desktop/Flowy.Bench). It is not part of Flowy.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Flowy.Core/Flowy.Core.csproj" />
  </ItemGroup>
</Project>
