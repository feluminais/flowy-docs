<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Rules beyond the defaults are listed in .editorconfig. -->
    <!-- Pinned: a newer SDK adds rules, and every warning here is an error, so the rule set moves when this number does. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <!-- Packages are checked against the advisory list on every restore, with the packages they bring in. A new advisory is reported, not
         allowed to break a build that was fine yesterday: CI fails on it separately (see the "Known vulnerabilities" step of ci.yml). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
