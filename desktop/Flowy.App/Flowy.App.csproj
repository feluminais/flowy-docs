<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FlowyDocs</AssemblyName>
    <RootNamespace>Flowy.App</RootNamespace>
    <Product>Flowy Docs</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) 2026 feluminais</Copyright>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- No ICU needed: nothing here depends on the culture's sort order or calendar, and a Linux install needs no libicu. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A publish for one system (-r) ships the code precompiled, so start-up doesn't spend its first second compiling it. Measured on
         Windows: 1.3 s from launch to the first picture became 0.9 s, for 17 MB more on disk. Without -r there is nothing to precompile for. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flowy.App.Tests" />
    <InternalsVisibleTo Include="Flowy.Bench" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="../Flowy.Core/Flowy.Core.csproj" />
    <AvaloniaResource Include="Assets/icon.png" />
    <Content Include="Assets/TABLER-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- highlight.js with our languages, built by desktop/tools/make-hljs-bundle.ts: the script that colours code, which Jint runs. -->
    <EmbeddedResource Include="Assets/hljs.js" LogicalName="hljs.js" />
    <Content Include="Assets/HIGHLIGHTJS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plum, the sample model: Help > Open the Demo, and the welcome window's button. Its code paths need the folders beside flowy/. -->
    <Content Include="../../docs/demo/**" Link="Demo/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-LICENCE-TEXTS.txt" Link="THIRD-PARTY-LICENCE-TEXTS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- SkiaSharp and HarfBuzz ship their native symbols (100 MB) inside the package; a release has no use for them. -->
  <Target Name="DropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::new('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>
</Project>
