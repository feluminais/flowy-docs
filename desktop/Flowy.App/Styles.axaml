<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- The palette of ui/src/style.css, light and dark. -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#fafaf9" />
          <SolidColorBrush x:Key="AccentTintBrush" Color="#2563eb" Opacity="0.10" />
          <SolidColorBrush x:Key="DangerTintBrush" Color="#b91c1c" Opacity="0.10" />
          <SolidColorBrush x:Key="HoverBrush" Color="#1c1917" Opacity="0.08" />
          <SolidColorBrush x:Key="WarnTintBrush" Color="#d97706" Opacity="0.14" />
          <!-- Pickers soft fills that show an outline only when focused. -->
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#2563eb" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#2563eb" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#ffffff" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#d6d3d1" />
          <!-- Text fields as soft fills too. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1c1917" Opacity="0.06" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2563eb" />
          <SolidColorBrush x:Key="FgBrush" Color="#1c1917" />
          <SolidColorBrush x:Key="MutedBrush" Color="#78716c" />
          <SolidColorBrush x:Key="LineBrush" Color="#d6d3d1" />
          <SolidColorBrush x:Key="EdgeBrush" Color="#a8a29e" />
          <SolidColorBrush x:Key="BoxBrush" Color="#ffffff" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2563eb" />
          <SolidColorBrush x:Key="WarnBgBrush" Color="#fef3c7" />
          <SolidColorBrush x:Key="WarnFgBrush" Color="#78350f" />
          <SolidColorBrush x:Key="WarnBrush" Color="#d97706" />
          <SolidColorBrush x:Key="DangerBrush" Color="#b91c1c" />
          <SolidColorBrush x:Key="ActorBrush" Color="#7f77dd" />
          <SolidColorBrush x:Key="SystemBrush" Color="#378add" />
          <SolidColorBrush x:Key="AppBrush" Color="#1d9e75" />
          <SolidColorBrush x:Key="StoreBrush" Color="#d4537e" />
          <SolidColorBrush x:Key="ComponentBrush" Color="#d85a30" />
          <SolidColorBrush x:Key="ExternalBrush" Color="#888780" />
          <SolidColorBrush x:Key="ActorTileBrush" Color="#7f77dd" Opacity="0.18" />
          <SolidColorBrush x:Key="SystemTileBrush" Color="#378add" Opacity="0.18" />
          <SolidColorBrush x:Key="AppTileBrush" Color="#1d9e75" Opacity="0.18" />
          <SolidColorBrush x:Key="StoreTileBrush" Color="#d4537e" Opacity="0.18" />
          <SolidColorBrush x:Key="ComponentTileBrush" Color="#d85a30" Opacity="0.18" />
          <SolidColorBrush x:Key="ExternalTileBrush" Color="#888780" Opacity="0.18" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#1c1917" />
          <SolidColorBrush x:Key="AccentTintBrush" Color="#60a5fa" Opacity="0.16" />
          <SolidColorBrush x:Key="DangerTintBrush" Color="#f87171" Opacity="0.16" />
          <SolidColorBrush x:Key="HoverBrush" Color="#f5f5f4" Opacity="0.10" />
          <SolidColorBrush x:Key="WarnTintBrush" Color="#f59e0b" Opacity="0.16" />
          <!-- Pickers soft fills that show an outline only when focused. -->
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#60a5fa" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#60a5fa" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#292524" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#57534e" />
          <!-- Text fields as soft fills too. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#f5f5f4" Opacity="0.07" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#60a5fa" />
          <SolidColorBrush x:Key="FgBrush" Color="#f5f5f4" />
          <SolidColorBrush x:Key="MutedBrush" Color="#a8a29e" />
          <SolidColorBrush x:Key="LineBrush" Color="#57534e" />
          <SolidColorBrush x:Key="EdgeBrush" Color="#78716c" />
          <SolidColorBrush x:Key="BoxBrush" Color="#292524" />
          <SolidColorBrush x:Key="AccentBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="WarnBgBrush" Color="#451a03" />
          <SolidColorBrush x:Key="WarnFgBrush" Color="#fde68a" />
          <SolidColorBrush x:Key="WarnBrush" Color="#f59e0b" />
          <SolidColorBrush x:Key="DangerBrush" Color="#f87171" />
          <SolidColorBrush x:Key="ActorBrush" Color="#afa9ec" />
          <SolidColorBrush x:Key="SystemBrush" Color="#85b7eb" />
          <SolidColorBrush x:Key="AppBrush" Color="#5dcaa5" />
          <SolidColorBrush x:Key="StoreBrush" Color="#ed93b1" />
          <SolidColorBrush x:Key="ComponentBrush" Color="#f0997b" />
          <SolidColorBrush x:Key="ExternalBrush" Color="#b4b2a9" />
          <SolidColorBrush x:Key="ActorTileBrush" Color="#afa9ec" Opacity="0.18" />
          <SolidColorBrush x:Key="SystemTileBrush" Color="#85b7eb" Opacity="0.18" />
          <SolidColorBrush x:Key="AppTileBrush" Color="#5dcaa5" Opacity="0.18" />
          <SolidColorBrush x:Key="StoreTileBrush" Color="#ed93b1" Opacity="0.18" />
          <SolidColorBrush x:Key="ComponentTileBrush" Color="#f0997b" Opacity="0.18" />
          <SolidColorBrush x:Key="ExternalTileBrush" Color="#b4b2a9" Opacity="0.18" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.warntext">
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
  </Style>

  <!-- Icons share one stroke; their colours come from where they sit. -->
  <Style Selector="Path.btnicon, Path.ticon, Path.pickicon, Path.chipicon, Path.sectionicon, Path.closeicon, Path.zoomicon, Path.dirnicon, Path.rowicon, Path.crumbicon, Path.warnicon, Path.railicon, Path.navicon, Path.twisticon">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!--
    The top bar, flat like an editor's toolbar: no boxes round the controls, just an icon and a word on the bar itself. Hovering lays a tint
    under one; on (the Edit switch) a stronger one in the accent. Every control is 30 tall, so icon and text sit on one line.
  -->
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <Style Selector="Button.crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.crumb TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.crumb Path.crumbicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.crumb:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <Style Selector="Button.crumb:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.crumb:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.crumb:disabled Path.crumbicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Path.crumbsep"><Setter Property="Stroke" Value="{DynamicResource LineBrush}" /><Setter Property="StrokeThickness" Value="2" /><Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" /></Style>

  <!-- The flat button, on the bar and in the panels. The one filled button is .primary: what a form is for. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tool.icononly"><Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="30" /></Style>
  <Style Selector="Button.tool Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.tool TextBlock.btntext"><Setter Property="Foreground" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:pointerover Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Button.tool:pointerover TextBlock.btntext"><Setter Property="Foreground" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter, Button.tool.pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tool:pressed Path.btnicon, Button.tool.pressed Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.tool:pressed TextBlock.btntext, Button.tool.pressed TextBlock.btntext">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tool:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tool.primary Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource BgBrush}" /></Style>
  <Style Selector="Button.tool.primary TextBlock.btntext">
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tool.primary /template/ ContentPresenter, Button.tool.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tool.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.tool.primary:pointerover Path.btnicon, Button.tool.primary:pressed Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource BgBrush}" /></Style>
  <Style Selector="Button.tool.primary:pointerover TextBlock.btntext, Button.tool.primary:pressed TextBlock.btntext"><Setter Property="Foreground" Value="{DynamicResource BgBrush}" /></Style>
  <Style Selector="Button.tool.danger Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Button.tool.danger TextBlock.btntext"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Button.tool.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool.danger:pointerover Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Button.tool.danger:pointerover TextBlock.btntext"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Button.problems">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.problems:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource WarnTintBrush}" /></Style>
  <Style Selector="Button.problems Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource WarnBrush}" /></Style>
  <Style Selector="Button.problems TextBlock.btntext">
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <!-- The pickers on the bar are flat too: the words and a chevron, lit when pointed at. -->
  <Style Selector="ComboBox.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.flat:pointerover /template/ Border#Background, ComboBox.flat:pressed /template/ Border#Background, ComboBox.flat:focus-visible /template/ Border#Background, ComboBox.flat:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- The pieces of a panel, which reads like a document: a title with a rule in the type's colour under it, sections that are a small heading
       and a hairline, prose, and plain rows. Chips are small words in a line, a dot between (see Chrome.Chips). -->
  <Style Selector="Border.ttile"><Setter Property="Background" Value="{DynamicResource SystemTileBrush}" /></Style>
  <Style Selector="Path.ticon"><Setter Property="Stroke" Value="{DynamicResource SystemBrush}" /></Style>
  <Style Selector="Button.pick Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Path.pickicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>

  <!--
    Pickers: what can be chosen is drawn (a type's tile, a shape's outline, a colour, an icon), and the chosen one is ringed in the accent. The cells are
    soft tiles that light when pointed at; .wide ones are rows (the icon, the outside service, the type's own icon), .swatch ones are round.
  -->
  <Style Selector="Button.pick, ToggleButton.pick">
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2,8,2,6" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pick.wide, ToggleButton.pick.wide">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="6,5,10,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.pick.typecell"><Setter Property="Width" Value="66" /></Style>
  <Style Selector="Button.pick.swatch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pick.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource BoxBrush}" />
  </Style>
  <Style Selector="Button.pick:pointerover /template/ ContentPresenter, ToggleButton.pick:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.pick.on /template/ ContentPresenter, Button.pick.on:pointerover /template/ ContentPresenter, ToggleButton.pick:checked /template/ ContentPresenter, ToggleButton.pick:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.pick.swatch.on /template/ ContentPresenter, Button.pick.swatch.on:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.pick:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.pop"><Setter Property="Background" Value="{DynamicResource TextControlBackground}" /></Style>
  <Style Selector="Border.track"><Setter Property="Background" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="Ellipse.thumb"><Setter Property="Fill" Value="{DynamicResource BoxBrush}" /></Style>
  <Style Selector="ToggleButton:checked Border.track"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ToggleButton:checked Ellipse.thumb"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  <Style Selector="Button.reset">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.reset TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.reset:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>

  <Style Selector="Border.chip"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.chip.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.accent Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <!-- The progress of a flow: a segment a step, filled up to the one shown. -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Height" Value="4" />
  </Style>
  <Style Selector="Border.seg.done"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <!-- A group on the card: the bracket under the progress bar, a branch's lanes as tabs, a parallel stop's lane blocks, and the way back to the flow it was opened from. -->
  <Style Selector="Border.bracket">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.tab">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="Padding" Value="9,1" />
  </Style>
  <Style Selector="Border.tab TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.tab.on"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.tab.on TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.laneblock"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBlock.lane"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.trail"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <!-- The legend a grouped flow's card opens: what the chips, the bar and the labels on lines mean. -->
  <Style Selector="Border.legend"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <Style Selector="Button.legendbutton.on Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.warn Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource WarnBrush}" /></Style>
  <Style Selector="Border.ttile.actor"><Setter Property="Background" Value="{DynamicResource ActorTileBrush}" /></Style>
  <Style Selector="Border.ttile.actor Path.ticon"><Setter Property="Stroke" Value="{DynamicResource ActorBrush}" /></Style>
  <Style Selector="Border.chip.actor TextBlock"><Setter Property="Foreground" Value="{DynamicResource ActorBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.actor Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource ActorBrush}" /></Style>
  <Style Selector="Border.ttile.system"><Setter Property="Background" Value="{DynamicResource SystemTileBrush}" /></Style>
  <Style Selector="Border.ttile.system Path.ticon"><Setter Property="Stroke" Value="{DynamicResource SystemBrush}" /></Style>
  <Style Selector="Border.chip.system TextBlock"><Setter Property="Foreground" Value="{DynamicResource SystemBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.system Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource SystemBrush}" /></Style>
  <Style Selector="Border.ttile.app"><Setter Property="Background" Value="{DynamicResource AppTileBrush}" /></Style>
  <Style Selector="Border.ttile.app Path.ticon"><Setter Property="Stroke" Value="{DynamicResource AppBrush}" /></Style>
  <Style Selector="Border.chip.app TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.app Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource AppBrush}" /></Style>
  <Style Selector="Border.ttile.store"><Setter Property="Background" Value="{DynamicResource StoreTileBrush}" /></Style>
  <Style Selector="Border.ttile.store Path.ticon"><Setter Property="Stroke" Value="{DynamicResource StoreBrush}" /></Style>
  <Style Selector="Border.chip.store TextBlock"><Setter Property="Foreground" Value="{DynamicResource StoreBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.store Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource StoreBrush}" /></Style>
  <Style Selector="Border.ttile.component"><Setter Property="Background" Value="{DynamicResource ComponentTileBrush}" /></Style>
  <Style Selector="Border.ttile.component Path.ticon"><Setter Property="Stroke" Value="{DynamicResource ComponentBrush}" /></Style>
  <Style Selector="Border.chip.component TextBlock"><Setter Property="Foreground" Value="{DynamicResource ComponentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.component Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource ComponentBrush}" /></Style>
  <Style Selector="Border.ttile.external"><Setter Property="Background" Value="{DynamicResource ExternalTileBrush}" /></Style>
  <Style Selector="Border.ttile.external Path.ticon"><Setter Property="Stroke" Value="{DynamicResource ExternalBrush}" /></Style>
  <Style Selector="Border.chip.external TextBlock"><Setter Property="Foreground" Value="{DynamicResource ExternalBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.chip.external Path.chipicon"><Setter Property="Stroke" Value="{DynamicResource ExternalBrush}" /></Style>
  <Style Selector="Path.sectionicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.count TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Opacity" Value="0.75" /></Style>
  <Style Selector="Border.hairline">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <!-- A note set beside the text by a rule, like a quote: a connection of a line, what to do next, a step being recorded. -->
  <Style Selector="Border.inset">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="14,2,0,2" />
  </Style>
  <!-- A row of files, links or connections: plain, lit when pointed at. -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="-8,0" />
  </Style>
  <Style Selector="Border.row:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Border.row.lines:pointerover"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <!-- A callout beside the text, like a quote: what is wrong with a box or a line. -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="0,8,8,0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- A direction arrow is only drawn; a step's number and a panel's heading sit in a round tint. -->
  <Style Selector="Border.dirn">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Path.dirnicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.dirn TextBlock, Border.badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.rowicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <!-- The Data section of a store: an entry's header is a toggle that is plain until pointed at; a grid has its headings on a faint fill and a rule between rows; a note is a strip with the column or field it is about. -->
  <Style Selector="ToggleButton.datahead">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.datahead /template/ ContentPresenter, ToggleButton.datahead:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="ToggleButton.datahead:pointerover /template/ ContentPresenter, ToggleButton.datahead:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.datahead:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1.5" /></Style>
  <Style Selector="Border.datafill"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
  <Style Selector="Border.datarule"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="0,1,0,0" /><Setter Property="Opacity" Value="0.6" /></Style>
  <Style Selector="Ellipse.datadot"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></Style>
  <Style Selector="Border.datacode"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="5,1" /></Style>
  <Style Selector="Border.datanote">
    <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="0,6,6,0" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Path.warnicon"><Setter Property="Stroke" Value="{DynamicResource WarnFgBrush}" /></Style>

  <!-- A box: its shape (a fill, a tint of its own colour, an outline, and a coloured outline over it), the tile, the name, how many are inside. -->
  <Style Selector=":is(Grid).box">
    <Setter Property="Width" Value="200" />
    <Setter Property="Height" Value="72" />
  </Style>
  <Style Selector=":is(Grid).box Path.fillbase">
    <Setter Property="Fill" Value="{DynamicResource BoxBrush}" />
  </Style>
  <Style Selector=":is(Grid).box Path.tint">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Grid).box.tinted Path.tint">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Grid).box Path.outline">
    <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box Path.colorline">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box.colored Path.colorline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Grid).box.outsider">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector=":is(Grid).box.outsider Path.outline">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="4,3" />
  </Style>
  <Style Selector=":is(Grid).box.outsider Path.colorline, :is(Grid).box.selected Path.colorline, :is(Grid).box.lit Path.colorline">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Grid).box.selected Path.outline">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector=":is(Grid).box.dim">
    <Setter Property="Opacity" Value="0.15" />
  </Style>
  <Style Selector=":is(Grid).box.lit">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=":is(Grid).box.lit Path.outline">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="" />
  </Style>
  <Style Selector=":is(Grid).box Path.glow">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Stroke" Value="#402563eb" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box.lit Path.glow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Grid).box Border.tile">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SystemTileBrush}" />
  </Style>
  <Style Selector=":is(Grid).box Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource SystemBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box.actor Border.tile"><Setter Property="Background" Value="{DynamicResource ActorTileBrush}" /></Style>
  <Style Selector=":is(Grid).box.actor Path.icon"><Setter Property="Stroke" Value="{DynamicResource ActorBrush}" /></Style>
  <Style Selector=":is(Grid).box.app Border.tile"><Setter Property="Background" Value="{DynamicResource AppTileBrush}" /></Style>
  <Style Selector=":is(Grid).box.app Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBrush}" /></Style>
  <Style Selector=":is(Grid).box.store Border.tile"><Setter Property="Background" Value="{DynamicResource StoreTileBrush}" /></Style>
  <Style Selector=":is(Grid).box.store Path.icon"><Setter Property="Stroke" Value="{DynamicResource StoreBrush}" /></Style>
  <Style Selector=":is(Grid).box.component Border.tile"><Setter Property="Background" Value="{DynamicResource ComponentTileBrush}" /></Style>
  <Style Selector=":is(Grid).box.component Path.icon"><Setter Property="Stroke" Value="{DynamicResource ComponentBrush}" /></Style>
  <Style Selector=":is(Grid).box.external Border.tile"><Setter Property="Background" Value="{DynamicResource ExternalTileBrush}" /></Style>
  <Style Selector=":is(Grid).box.external Path.icon"><Setter Property="Stroke" Value="{DynamicResource ExternalBrush}" /></Style>
  <Style Selector=":is(Grid).box TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector=":is(Grid).box TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector=":is(Grid).box TextBlock.inside">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector=":is(Grid).box Path.zoom">
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box Border.badge">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector=":is(Grid).box.problem Border.badge">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- A load (the Performance panel): an outline from green to red over the shape's own, with a glow, and how many are waiting in the corner. -->
  <Style Selector=":is(Grid).box Path.strain">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box Path.strainglow">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector=":is(Grid).box.strained Path.strain, :is(Grid).box.strained Path.strainglow">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=":is(Grid).box Border.queue">
    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(Grid).box Border.queue TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The marks of a key (the Performance panel), each drawn as it looks on the chart or the canvas. -->
  <Style Selector="Border.sw, Line.knee">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Border.sw.p50, Border.sw.p95, Border.sw.busy">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.sw.p95"><Setter Property="Background" Value="{DynamicResource WarnBrush}" /></Style>
  <Style Selector="Border.sw.busy">
    <Setter Property="Height" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Line.knee"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.sw.heat">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Border.sw.none">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Border.sw.queue">
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Border.sw.queue TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sw.call">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.sw.call.bad"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector=":is(Grid).box:focus-visible Path.outline">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <!-- The zoom buttons in the corner of the canvas: one rounded group with flat buttons in it, like the bar's. -->
  <Style Selector="Border.zoomgroup">
    <Setter Property="Background" Value="{DynamicResource BoxBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.zoom">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.zoom Path.zoomicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.zoom:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.zoom:pointerover Path.zoomicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>

  <!-- The side panel and what's in it. -->
  <Style Selector=":is(Border).panel">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BoxShadow" Value="-12 0 32 0 #1a000000" />
  </Style>
  <Style Selector="Button.close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.close Path.closeicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.close:pointerover Path.closeicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Button.link, Button.disclosure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.disclosure">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter, Button.disclosure:pointerover /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter, Button.disclosure:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Cards over the canvas: the player, search, the shortcut list. -->
  <Style Selector=":is(Border).card">
    <Setter Property="Background" Value="{DynamicResource BoxBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #33000000" />
  </Style>
  <Style Selector=":is(Border).notice">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #33000000" />
  </Style>
  <Style Selector=":is(Border).notice TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Border.banner TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Button.result">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.result.at /template/ ContentPresenter, Button.result:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Edit mode: the dot under a box to draw a connection from. -->
  <Style Selector=":is(Grid).box Ellipse.handle">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource BoxBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <!-- The navigator: the rail on the left edge, the strip of tabs, the Flows list and the Explorer tree (Navigator.cs, FlowsView.cs, ExplorerView.cs); the Details rail on the right edge. -->
  <Style Selector=":is(Border).rail">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector=":is(Border).rail.railleft"><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
  <Style Selector=":is(Border).panel.navpanel">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BoxShadow" Value="12 0 32 0 #1a000000" />
  </Style>
  <!-- The strip you drag to resize a side panel (Sash.cs): invisible until the pointer is on it, then lit like VS Code's. -->
  <Style Selector=":is(Border).sash"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector=":is(Border).sash:pointerover"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector=":is(Border).sash.drag"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector=":is(Border).sash:focus-visible"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.railbutton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.railbutton Path.railicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.railbutton:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.railbutton:pointerover Path.railicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Button.railbutton.active /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <Style Selector="Button.railbutton.active Path.railicon"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.railcount">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.railcount TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.railcount.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector=":is(StackPanel).navtabs Button.navtab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector=":is(StackPanel).navtabs Button.navtab:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector=":is(StackPanel).navtabs Button.navtab:pointerover"><Setter Property="Foreground" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector=":is(StackPanel).navtabs Button.navtab.on /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector=":is(StackPanel).navtabs Button.navtab.on"><Setter Property="Foreground" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Border.navfind">
    <Setter Property="Background" Value="{DynamicResource BoxBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.navfind:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Path.navicon, Path.twisticon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.flowrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.flowrow:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.flowrow.current /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <Style Selector="Button.flowrow.current TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.flowrow Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="ListBox.treelist">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,0,12,0" /> <!-- FlowsView.Inset: inside the scroll area, so the scroll bar can sit on the panel's edge -->
  </Style>
  <Style Selector="ListBox.treelist ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.treelist ListBoxItem:pointerover /template/ ContentPresenter, ListBox.treelist ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBox.treelist:focus-within ListBoxItem:selected:not(.canvas) /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.treerow"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.treerow:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Border.treerow.sel"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /></Style>
  <Style Selector="Border.twist"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBlock.treename.sel"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBlock.treename.dim, TextBlock.treecount"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.treedot"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
</Styles>