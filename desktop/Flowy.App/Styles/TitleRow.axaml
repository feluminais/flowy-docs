<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The styles of the window's top row: TitleRow loads them (AreaStyles.cs), so no control outside it is checked against them. -->
  <Style Selector="Border.titlerow"><Setter Property="Background" Value="{DynamicResource BgBrush}" /></Style>
</Styles>
