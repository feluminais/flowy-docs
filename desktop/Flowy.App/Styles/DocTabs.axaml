<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The styles of the row of tabs: DocTabsBar loads them (AreaStyles.cs), so no control outside it is checked against them. -->
  <Style Selector=":is(Border).doctabs">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <!-- A model and its sketches, inside one outline. -->
  <Style Selector="Border.docgroup">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.doctab">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="Border.doctab:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Border.doctab.active">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.docpick">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.docpick:pointerover /template/ ContentPresenter, Button.docpick:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBlock.docname">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.doctab:pointerover TextBlock.docname"><Setter Property="Foreground" Value="{DynamicResource FgBrush}" /></Style>
  <Style Selector="Border.doctab.active TextBlock.docname">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.docclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.docclose Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.docclose:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Style>
  <Style Selector="Button.docclose:pointerover Path.btnicon"><Setter Property="Stroke" Value="{DynamicResource FgBrush}" /></Style>
</Styles>
