{
  "lineStyle": "straight",
  "objects": [
    {
      "id": "steps",
      "type": "system",
      "name": "Step animations",
      "description": "One pair of shapes for each way a step can travel, named for the animation they play.\n\nEach animation has a flow of its own with a single step to click through: Send, Call, Event, Callback, Flash, Bolt drop,\nSend with a word, Fail and Timeout (Flash has two, because the step before sets it off).\n\n**Every step animation** plays them all: press **P** to watch them one after the other.\n"
    },
    {
      "id": "structure",
      "type": "system",
      "name": "Flow structure",
      "description": "One set of shapes for each way steps can be grouped: **Repeat**, **Branch**, **Parallel** and **Flow link**.\n\nEach has a flow of the same name, with the chip, lane tabs and progress bar that go with it.\n"
    },
    {
      "id": "performance",
      "type": "system",
      "name": "Performance",
      "description": "One shape for each thing a load test can show, named for what it shows.\n\nOpen the Performance tab (**T**), pick **Every load effect**, then press **Ramp** or step the levels with the arrow keys.\n"
    },
    {
      "id": "send-from",
      "type": "app",
      "name": "Send · from",
      "in": "steps",
      "tech": "send",
      "description": "`animation: send`. Something runs one way along the line. The sender does not wait."
    },
    {
      "id": "send-to",
      "type": "store",
      "name": "Send · to",
      "in": "steps",
      "shape": "queue",
      "tech": "send",
      "description": "Takes the envelope in with a squash."
    },
    {
      "id": "call-from",
      "type": "app",
      "name": "Call · from",
      "in": "steps",
      "tech": "call",
      "description": "`animation: call`. The envelope goes, the sender waits, and the reply comes back."
    },
    {
      "id": "call-to",
      "type": "store",
      "name": "Call · to",
      "in": "steps",
      "tech": "call",
      "description": "Takes the envelope in, then answers."
    },
    {
      "id": "event-from",
      "type": "app",
      "name": "Event · from",
      "in": "steps",
      "tech": "event",
      "description": "`animation: event`. A bolt runs along the line, and the receiver flashes."
    },
    {
      "id": "event-to",
      "type": "app",
      "name": "Event · to",
      "in": "steps",
      "shape": "hexagon",
      "tech": "event",
      "description": "Flashes when the bolt arrives."
    },
    {
      "id": "callback-from",
      "type": "app",
      "name": "Callback · from",
      "in": "steps",
      "tech": "callback",
      "description": "`animation: callback`. A ring leaves this shape and a bell runs to the subscriber."
    },
    {
      "id": "callback-to",
      "type": "app",
      "name": "Callback · to",
      "in": "steps",
      "tech": "callback",
      "description": "The subscriber. A ring goes out when the bell arrives."
    },
    {
      "id": "after-source",
      "type": "app",
      "name": "Flash · source",
      "in": "steps",
      "tech": "send, then callback",
      "description": "Hands something to the publisher, which is what sets the callback off."
    },
    {
      "id": "after-from",
      "type": "app",
      "name": "Flash · from",
      "in": "steps",
      "tech": "callback, trigger outside",
      "description": "`animation: {kind: callback, trigger: outside}`, right after a step that landed here. This shape flashes, then the bell runs."
    },
    {
      "id": "after-to",
      "type": "app",
      "name": "Flash · to",
      "in": "steps",
      "tech": "callback, trigger outside",
      "description": "The subscriber."
    },
    {
      "id": "cold-from",
      "type": "app",
      "name": "Bolt drop · from",
      "in": "steps",
      "tech": "callback, trigger outside",
      "description": "`animation: {kind: callback, trigger: outside}`, with no step before it that landed here. A bolt drops onto this shape, then the bell runs."
    },
    {
      "id": "cold-to",
      "type": "app",
      "name": "Bolt drop · to",
      "in": "steps",
      "tech": "callback, trigger outside",
      "description": "The subscriber."
    },
    {
      "id": "fail-from",
      "type": "app",
      "name": "Fail · from",
      "in": "steps",
      "tech": "send, fail",
      "description": "`animation: {kind: send, outcome: fail}`. The envelope runs to the receiver, which refuses it."
    },
    {
      "id": "fail-to",
      "type": "app",
      "name": "Fail · to",
      "in": "steps",
      "tech": "send, fail",
      "description": "Flashes when the refusal arrives."
    },
    {
      "id": "timeout-from",
      "type": "app",
      "name": "Timeout · from",
      "in": "steps",
      "tech": "call, timeout",
      "description": "`animation: {kind: call, outcome: timeout}`. The envelope goes, the sender waits, no reply comes, and the line dims."
    },
    {
      "id": "timeout-to",
      "type": "app",
      "name": "Timeout · to",
      "in": "steps",
      "tech": "call, timeout",
      "description": "Takes the envelope in and never answers."
    },
    {
      "id": "repeat-from",
      "type": "app",
      "name": "Repeat · from",
      "in": "structure",
      "description": "The caller. It asks again until the service answers."
    },
    {
      "id": "repeat-to",
      "type": "app",
      "name": "Repeat · to",
      "in": "structure",
      "description": "The service. It is busy on the first two tries."
    },
    {
      "id": "branch-from",
      "type": "app",
      "name": "Branch · from",
      "in": "structure",
      "description": "Decides which lane happens."
    },
    {
      "id": "branch-a",
      "type": "app",
      "name": "Branch · lane A",
      "in": "structure",
      "description": "Takes the first lane."
    },
    {
      "id": "branch-b",
      "type": "app",
      "name": "Branch · lane B",
      "in": "structure",
      "description": "Takes the second lane."
    },
    {
      "id": "parallel-from",
      "type": "app",
      "name": "Parallel · from",
      "in": "structure",
      "description": "Starts all three lanes together."
    },
    {
      "id": "parallel-a",
      "type": "app",
      "name": "Parallel · lane A",
      "in": "structure",
      "description": "Has two steps, so lane A keeps going after the others have finished."
    },
    {
      "id": "parallel-b",
      "type": "app",
      "name": "Parallel · lane B",
      "in": "structure",
      "description": "One step."
    },
    {
      "id": "parallel-c",
      "type": "app",
      "name": "Parallel · lane C",
      "in": "structure",
      "description": "One step."
    },
    {
      "id": "link-from",
      "type": "app",
      "name": "Flow link · from",
      "in": "structure",
      "description": "Hands the story to another flow."
    },
    {
      "id": "link-to",
      "type": "app",
      "name": "Flow link · to",
      "in": "structure",
      "description": "Where the other flow carries on."
    },
    {
      "id": "load",
      "type": "app",
      "name": "Load",
      "in": "performance",
      "description": "Where the load comes in. Every shape below is reached from here."
    },
    {
      "id": "traffic",
      "type": "app",
      "name": "Traffic",
      "in": "performance",
      "description": "The line from Load gets thicker and busier as the load goes up. The shape itself stays plain."
    },
    {
      "id": "latency",
      "type": "app",
      "name": "Latency",
      "in": "performance",
      "description": "The dots on the line from Load slow down as calls take longer. The shape itself stays plain."
    },
    {
      "id": "failing-calls",
      "type": "app",
      "name": "Failing calls",
      "in": "performance",
      "description": "More and more of the dots on the line from Load turn red. The shape itself stays plain."
    },
    {
      "id": "strain",
      "type": "app",
      "name": "Strain",
      "in": "performance",
      "description": "Busy. The outline runs from green to red as the shape uses more of its capacity, from 10% at 10 requests/s to 100% at 160."
    },
    {
      "id": "failing-shape",
      "type": "app",
      "name": "Failing shape",
      "in": "performance",
      "description": "Busy because calls fail. Failing 5% counts as full, so the outline runs to red early."
    },
    {
      "id": "queue",
      "type": "store",
      "name": "Queue",
      "in": "performance",
      "shape": "queue",
      "description": "Waiting. The number is how many calls are waiting, from 0 to 3000. The outline stays plain because only the waiting was measured."
    },
    {
      "id": "not-measured",
      "type": "app",
      "name": "Not measured",
      "in": "performance",
      "description": "Nothing was measured here, so it stays plain at every load. Missing is never drawn as zero."
    },
    {
      "id": "rolled-up",
      "type": "app",
      "name": "Rolled up",
      "in": "performance",
      "description": "A shape that holds others shows the worst strain inside it and the waiting added up.\n\nDouble-click it to see each part.\n"
    },
    {
      "id": "rolled-a",
      "type": "component",
      "name": "Rolled up · A",
      "in": "rolled-up",
      "description": "Busy and waiting both grow. At 10 requests/s it is 20% busy with nothing waiting, and at 160 it is 90% busy with 120 waiting."
    },
    {
      "id": "rolled-b",
      "type": "component",
      "name": "Rolled up · B",
      "in": "rolled-up",
      "description": "Waits for 10 calls at every load, and gets less busy as the load goes up, from 50% to 30%."
    }
  ],
