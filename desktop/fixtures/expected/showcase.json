    {
      "id": "bolt-drop",
      "name": "Bolt drop",
      "view": "steps",
      "steps": [
        {
          "from": "cold-from",
          "to": "cold-to",
          "text": "Runs a callback that something outside set off",
          "animation": {
            "kind": "callback",
            "trigger": "outside"
          },
          "placed": [
            "cold-from",
            "cold-to"
          ],
          "ends": "Bolt drop · from → Bolt drop · to"
        }
      ]
    },
    {
      "id": "branch",
      "name": "Branch",
      "view": "structure",
      "steps": [
        {
          "from": "branch-from",
          "to": "branch-a",
          "text": "Hands the order to lane A",
          "group": "outcome",
          "lane": "The card is accepted",
          "placed": [
            "branch-from",
            "branch-a"
          ],
          "ends": "Branch · from → Branch · lane A"
