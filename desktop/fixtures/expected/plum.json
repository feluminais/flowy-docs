  "layout": {},
  "flows": [
    {
      "id": "announce-order",
      "name": "A paid order is announced",
      "view": "ordering",
      "steps": [
        {
          "from": "order-api",
          "to": "events",
          "text": "Announces that the order is paid and carries on without waiting",
          "placed": [
            "order-api",
            "events"
          ],
          "ends": "Order API → Order events"
        },
        {
          "from": "events",
          "to": "dispatch",
          "text": "Hands the event to Dispatch, which starts looking for a courier",
          "group": "readers",
          "lane": "Delivery",
          "flow": "deliver-order",
          "placed": [
            "events",
            "delivery"
          ],
          "ends": "Order events → Dispatch in Delivery"
        },
        {
          "from": "events",
          "to": "warehouse",
          "text": "Streams the same event to the warehouse for its own records",
          "group": "readers",
          "lane": "Warehouse",
          "placed": [
            "events",
            "backoffice"
          ],
          "ends": "Order events → Data warehouse in Back office"
        }
      ],
      "groups": {
        "readers": {
          "kind": "parallel"
        }
      }
    },
    {
      "id": "capture-payment",
      "name": "The payment is captured",
      "view": "ordering",
      "steps": [
        {
          "from": "order-api",
          "to": "stripe",
          "text": "Captures the amount it held",
          "group": "charge",
          "placed": [
            "order-api",
            "stripe"
          ],
          "ends": "Order API → Stripe"
        },
        {
          "from": "stripe",
          "to": "order-api",
          "text": "Doesn't answer within five seconds",
          "group": "charge",
          "placed": [
            "stripe",
            "order-api"
          ],
          "ends": "Stripe → Order API"
        },
        {
          "from": "stripe",
          "to": "order-api",
          "text": "Confirms the charge",
          "group": "outcome",
          "lane": "The charge goes through",
          "placed": [
            "stripe",
            "order-api"
          ],
          "ends": "Stripe → Order API"
        },
        {
          "from": "order-api",
          "to": "orders-db",
          "text": "Marks the order paid",
          "group": "outcome",
          "placed": [
            "order-api",
            "orders-db"
          ],
          "ends": "Order API → Orders DB"
        },
        {
          "from": "stripe",
          "to": "order-api",
          "text": "Declines the card",
          "description": "A decline is final: it is not retried. The hold is released, and the app asks the customer\nfor another card.\n",
          "group": "outcome",
          "lane": "The card is declined",
          "placed": [
            "stripe",
            "order-api"
          ],
          "ends": "Stripe → Order API"
        },
        {
          "from": "order-api",
          "to": "customer-app",
          "text": "Asks the customer to try another card",
          "group": "outcome",
          "placed": [
            "order-api",
            "customer-app"
          ],
          "ends": "Order API → Customer app"
        }
      ],
      "groups": {
        "charge": {
          "kind": "repeat",
          "times": "3",
          "text": "Waits 1 s, then 2 s, then 4 s between tries. Plum's client gives up after three."
        },
        "outcome": {
          "kind": "branch"
        }
      }
    },
    {
      "id": "deliver-order",
      "name": "A courier delivers it",
      "view": "delivery",
      "steps": [
        {
          "from": "events",
          "to": "dispatch",
          "text": "Hears that an order was placed",
          "placed": [
            "ordering",
            "dispatch"
          ],
          "ends": "Order events in Ordering → Dispatch"
        },
        {
          "from": "dispatch",
          "to": "fleet-db",
          "text": "Finds idle couriers near the restaurant",
          "placed": [
            "dispatch",
            "fleet-db"
          ],
          "ends": "Dispatch → Fleet DB"
        },
        {
          "from": "dispatch",
          "text": "Ranks them by how soon each could arrive",
          "description": "The **Matcher** asks **ETA** for a travel time per courier, using distance, traffic and the\nvehicle. The quickest one is offered the job first.\n",
          "placed": [
            "dispatch",
            "dispatch"
          ],
          "ends": "Dispatch"
        },
        {
          "from": "dispatch",
          "to": "notifier",
          "text": "Sends the offer as a push",
          "placed": [
            "dispatch",
            "notifications"
          ],
          "ends": "Dispatch → Notifier in Notifications"
        },
        {
          "from": "courier",
          "to": "courier-app",
          "text": "Accepts within 30 seconds",
          "placed": [
            "courier",
            "courier-app"
          ],
          "ends": "Courier → Courier app"
        },
        {
          "from": "courier-app",
          "to": "tracking",
          "text": "Streams its position every 5 seconds",
          "description": "Only while a job is open. A position older than a minute is dropped, so a courier who loses\nsignal stops moving on the customer's map instead of jumping when it comes back.\n",
          "placed": [
            "courier-app",
            "tracking"
          ],
          "ends": "Courier app → Live tracking"
        },
        {
          "from": "tracking",
          "to": "customer-app",
          "text": "The customer watches the courier come",
          "placed": [
            "tracking",
            "ordering"
          ],
          "ends": "Live tracking → Customer app in Ordering"
        },
        {
          "from": "courier-app",
          "to": "order-api",
          "text": "Marks the order delivered",
          "placed": [
            "courier-app",
            "ordering"
          ],
          "ends": "Courier app → Order API in Ordering"
        }
      ]
    },
    {
      "id": "place-order",
      "name": "Customer places an order",
      "view": "ordering",
      "steps": [
        {
          "from": "customer",
          "to": "customer-app",
          "text": "Fills a basket and taps Place order",
          "placed": [
            "customer",
            "customer-app"
          ],
          "ends": "Customer → Customer app"
        },
        {
          "from": "customer-app",
          "to": "order-api",
          "text": "POST /orders with the basket",
          "description": "The app sends an idempotency key with the request, so a double tap or a retry on a bad\nconnection places one order, not two.\n",
          "placed": [
            "customer-app",
            "order-api"
          ],
          "ends": "Customer app → Order API"
        },
        {
          "from": "order-api",
          "to": "stripe",
          "text": "Holds the amount on the card",
          "description": "**Checkout** asks Stripe to authorise the total. Nothing is charged yet: the money moves\nonce the restaurant accepts, and the hold is released if it refuses.\n",
          "placed": [
            "order-api",
            "stripe"
          ],
          "ends": "Order API → Stripe"
        },
        {
          "from": "order-api",
          "to": "orders-db",
          "text": "Saves the order as placed",
          "placed": [
            "order-api",
            "orders-db"
          ],
          "ends": "Order API → Orders DB"
        },
        {
          "from": "order-api",
          "to": "events",
          "text": "Announces the order",
          "placed": [
            "order-api",
            "events"
          ],
          "ends": "Order API → Order events"
        },
        {
          "from": "events",
          "to": "dispatch",
          "text": "Dispatch starts looking for a courier",
          "placed": [
            "events",
            "delivery"
          ],
          "ends": "Order events → Dispatch in Delivery"
        },
        {
          "from": "order-api",
          "to": "kitchen-tablet",
          "text": "The restaurant's tablet rings",
          "description": "The kitchen has two minutes to accept. After that the order is cancelled, the hold is\nreleased and the customer is told.\n",
          "placed": [
            "order-api",
            "kitchen-tablet"
          ],
          "ends": "Order API → Kitchen tablet"
        }
      ]
    },
    {
      "id": "refund",
      "name": "Support refunds an order",
      "view": "root",
      "steps": [
        {
          "from": "support",
          "to": "backoffice",
