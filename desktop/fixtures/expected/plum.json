{
  "lineStyle": "straight",
  "objects": [
    {
      "id": "customer",
      "type": "actor",
      "name": "Customer",
      "description": "Someone hungry, ordering from the Plum app or the website."
    },
    {
      "id": "restaurant",
      "type": "actor",
      "name": "Restaurant",
      "description": "The kitchen staff who accept an order and mark it ready."
    },
    {
      "id": "courier",
      "type": "actor",
      "name": "Courier",
      "description": "Rides or drives the order from the restaurant to the customer's door."
    },
    {
      "id": "support",
      "type": "actor",
      "name": "Support agent",
      "description": "Answers customers and couriers when something goes wrong."
    },
    {
      "id": "ordering",
      "type": "system",
      "name": "Ordering",
      "description": "Everything a customer touches: browsing menus, building a basket, paying.\n\nThe **Order API** is the only way in. It keeps orders in Postgres and announces every new\norder on the **Order events** bus, which is how **Delivery** hears about it.\n"
    },
    {
      "id": "delivery",
      "type": "system",
      "name": "Delivery",
      "description": "Finds a courier for each order and follows it to the door.\n\nDispatch matches and offers. Live tracking keeps the customer's map moving.\n"
    },
    {
      "id": "notifications",
      "type": "system",
      "name": "Notifications",
      "description": "Push, SMS and email, from one place, so no other system talks to a messaging provider."
    },
    {
      "id": "backoffice",
      "type": "system",
      "name": "Back office",
      "description": "Tools for Plum's own staff. Nothing here is visible to customers or couriers."
    },
    {
      "id": "stripe",
      "type": "system",
      "name": "Stripe",
      "external": "true",
      "description": "Takes card payments and sends refunds. Plum never sees a card number.\n\n[Provider status](https://status.stripe.com)\n"
    },
    {
      "id": "twilio",
      "type": "system",
      "name": "Twilio",
      "external": "true",
      "description": "Sends the SMS messages."
    },
    {
      "id": "mapbox",
      "type": "system",
      "name": "Mapbox",
      "external": "true",
      "description": "Maps, address lookup and travel times."
    },
    {
      "id": "customer-app",
      "type": "app",
      "name": "Customer app",
      "in": "ordering",
      "tech": "React Native",
      "description": "The app on the customer's phone. Browse, order, pay and watch the courier arrive.\n\nKeeps nothing but the basket and the session.\n",
      "code": [
        "apps/customer/"
      ]
    },
    {
      "id": "web",
      "type": "app",
      "name": "Website",
      "in": "ordering",
      "tech": "Next.js",
      "description": "The same ordering flow in a browser. Menus are rendered on the server so search engines see them."
    },
    {
      "id": "kitchen-tablet",
      "type": "app",
      "name": "Kitchen tablet",
      "in": "ordering",
      "tech": "Android",
      "description": "Rings when an order arrives. The kitchen taps **Accept**, then **Ready** when it can be collected."
    },
    {
      "id": "order-api",
      "type": "app",
      "name": "Order API",
      "in": "ordering",
      "tech": "Node, Fastify",
      "description": "Every client talks to this, and nothing else talks to the **Orders DB**.\n\n- `GET /menus/:restaurant` reads a menu\n- `POST /orders` places an order\n- `POST /orders/:id/refund` refunds one\n",
      "code": [
        "services/order-api/"
      ]
    },
    {
      "id": "orders-db",
      "type": "store",
      "name": "Orders DB",
      "in": "ordering",
      "tech": "Postgres",
      "description": "Orders, baskets and refunds. The source of truth for what a customer owes and was charged.",
