    {
      "id": "menu",
      "type": "component",
      "name": "Menu",
      "in": "order-api",
      "description": "Serves a restaurant's menu from the cache, and from the database when the cache is cold."
    },
    {
      "id": "basket",
      "type": "component",
      "name": "Basket",
      "in": "order-api",
      "description": "Holds what the customer picked and asks **Pricing** for the running total."
    },
    {
      "id": "pricing",
      "type": "component",
      "name": "Pricing",
      "in": "order-api",
      "description": "Works out the total: items, delivery fee (by distance) and any promotion.\n\nThe delivery fee uses the travel distance from Mapbox, rounded up to the next 500 m.\n",
      "code": [
        "services/order-api/src/pricing.ts"
      ]
    },
    {
      "id": "checkout",
      "type": "component",
      "name": "Checkout",
      "in": "order-api",
      "description": "Prices the basket, authorises the card and places the order.\n\nNothing is charged until the restaurant accepts. A rejected order releases the hold.\n",
      "code": [
        "services/order-api/src/checkout.ts"
      ]
    },
    {
      "id": "status",
      "type": "component",
      "name": "Order status",
      "in": "order-api",
      "description": "Moves an order through `placed`, `accepted`, `picked-up` and `delivered`, and announces each step."
    },
    {
      "id": "refunds",
      "type": "component",
      "name": "Refunds",
      "in": "order-api",
      "description": "Returns money to the card, then marks the order refunded. Support can refund in full or by line."
    },
    {
      "id": "courier-app",
      "type": "app",
      "name": "Courier app",
      "in": "delivery",
      "tech": "Kotlin, Swift",
      "description": "Offers, navigation and proof of delivery. Sends the courier's position every five seconds while a job is open."
    },
    {
      "id": "dispatch",
      "type": "app",
      "name": "Dispatch",
      "in": "delivery",
      "tech": "Go",
      "description": "Turns each new order into a courier on the way.\n\nIt reads `placed` events and offers the job to couriers one at a time, nearest first.\n",
      "code": [
        "services/dispatch/"
      ]
    },
    {
      "id": "tracking",
      "type": "app",
      "name": "Live tracking",
      "in": "delivery",
      "tech": "Go, WebSocket",
      "description": "Passes the courier's position to the customer's map. A position older than a minute is dropped."
    },
    {
      "id": "fleet-db",
      "type": "store",
      "name": "Fleet DB",
      "in": "delivery",
      "tech": "Postgres, PostGIS",
      "description": "Couriers, their vehicles, and their last known position."
    },
    {
      "id": "matcher",
      "type": "component",
      "name": "Matcher",
      "in": "dispatch",
      "description": "Ranks the idle couriers near a restaurant by how soon each could be there.",
      "code": [
        "services/dispatch/matcher.go"
      ]
    },
    {
      "id": "eta",
      "type": "component",
      "name": "ETA",
      "in": "dispatch",
      "description": "Estimates travel time from distance, traffic and the courier's vehicle."
    },
    {
      "id": "offers",
      "type": "component",
      "name": "Offers",
      "in": "dispatch",
      "description": "Offers a job to one courier at a time and waits 30 seconds for an answer.\n\nA refusal or a timeout moves on to the next courier.\n"
    },
    {
      "id": "notifier",
      "type": "app",
      "name": "Notifier",
      "in": "notifications",
      "tech": "Node",
      "description": "Picks push, SMS or email for each message and sends it. Never blocks the caller."
    },
    {
      "id": "templates",
      "type": "store",
      "name": "Message templates",
      "in": "notifications",
      "tech": "Postgres",
      "description": "The wording of every message, per language."
    },
    {
      "id": "admin",
      "type": "app",
      "name": "Admin dashboard",
      "in": "backoffice",
      "tech": "React",
      "description": "Restaurants, delivery zones, promotions and the weekly reports."
    },
    {
      "id": "support-console",
      "type": "app",
      "name": "Support console",
      "in": "backoffice",
      "tech": "React",
      "description": "Look up an order, see where the courier is, issue a refund."
    },
    {
      "id": "warehouse",
      "type": "store",
      "name": "Data warehouse",
      "in": "backoffice",
      "tech": "ClickHouse",
      "description": "Every order event, kept for reporting. Nothing reads it except the **Admin dashboard**."
    }
  ],
