    {
      "id": "events",
      "type": "store",
      "name": "Order events",
      "in": "ordering",
      "shape": "queue",
      "tech": "Kafka",
      "description": "One message for every change to an order: `placed`, `accepted`, `picked-up`, `delivered`.\n\nDispatch reads from it, and so does the warehouse.\n",
      "data": [
        {
          "name": "order-events",
          "kind": "topic",
          "limits": "Kept 7 days, 6 partitions",
          "note": "Keyed by order id, so one order's messages stay in order.",
          "columns": [
            "Key",
            "Value"
          ],
          "rows": [
