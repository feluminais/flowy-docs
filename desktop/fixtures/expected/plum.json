        },
        {
          "from": "backoffice",
          "to": "ordering",
          "text": "Asks for a refund, in full or by line",
          "placed": [
            "backoffice",
            "ordering"
          ],
          "ends": "Back office → Ordering"
        },
        {
          "from": "ordering",
          "to": "stripe",
          "text": "The money goes back to the card",
          "description": "Stripe refunds the original charge. The order is marked refunded only once Stripe has\nconfirmed, so the database never says money was returned that wasn't.\n",
          "placed": [
            "ordering",
            "stripe"
          ],
          "ends": "Ordering → Stripe"
        },
        {
          "from": "ordering",
          "to": "notifications",
          "text": "Asks for a confirmation to be sent",
          "placed": [
            "ordering",
            "notifications"
          ],
          "ends": "Ordering → Notifications"
        },
        {
          "from": "notifications",
          "to": "twilio",
          "text": "The customer gets an SMS",
          "placed": [
            "notifications",
            "twilio"
          ],
          "ends": "Notifications → Twilio"
        }
      ]
    }
