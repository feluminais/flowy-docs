{
  "legend": [
    {
      "kind": "repeat",
      "title": "Repeat",
      "text": "The same steps again. A solid line is a set number of times, a dashed one can stop sooner. The chip says how many times, or what stops it."
    },
    {
      "kind": "branch",
      "title": "Branch",
      "text": "Only one lane happens. Each row of the bar is a lane, named for what decides it. The lanes you are not in are hollow on the bar and dashed on the canvas."
    },
    {
      "kind": "parallel",
      "title": "Same time",
      "text": "Lanes that run together. Each stop lights the next step of every lane."
    },
    {
      "kind": null,
      "title": "The bar",
      "text": "One cell for each stop, and a row for each lane of a branch. A box holds the stops of each group, and the line under it says what the group is. Point at one for more."
    },
    {
      "kind": null,
      "title": "The label on a line",
      "text": "Which lane, or which repeat, the step is in."
    }
  ],
