            "management"
          ],
          "ends": "UI → Management",
          "rides": "management ui|ui>management|Start scan"
        },
        {
          "from": "ui",
          "to": "management",
          "text": "The screen sends its request",
          "placed": [
            "ui",
            "management"
          ],
          "ends": "UI → Management",
          "rides": "management ui|ui>management|Start scan",
          "payload": "scan-request",
          "sends": "Scan request",
          "dots": {
            "out": "Scan request"
          }
        },
        {
          "from": "banner",
          "to": "agent",
          "text": "The banner asks the agent",
          "placed": [
            "ui",
            "management"
          ],
          "ends": "Banner in UI → Agent in Management",
          "rides": "management ui|ui>management|Banner"
        },
        {
          "from": "ui",
          "to": "agent",
          "text": "Nothing says which line",
          "placed": [
            "ui",
            "management"
          ],
          "ends": "UI → Agent in Management",
          "rides": "management ui|ui>management|Request and reply"
        },
        {
          "from": "ui",
          "to": "management",
          "text": "The screen names a line that is not there",
          "via": "Nope",
          "placed": [
            "ui",
            "management"
          ],
          "ends": "UI → Management",
          "rides": "management ui|ui>management|Request and reply"
        },
        {
          "from": "management",
          "to": "ui",
          "text": "Results reach the screen",
          "placed": [
            "management",
            "ui"
          ],
          "ends": "Management → UI",
          "rides": "management ui|management>ui|Scan results"
        },
        {
          "from": "management",
          "to": "ui",
          "text": "The first results come back",
          "via": "Start scan",
          "placed": [
            "management",
            "ui"
          ],
          "ends": "Management → UI",
          "rides": "management ui|ui>management|Start scan"
        },
        {
          "from": "cloud",
          "to": "management",
          "text": "The update comes back",
          "placed": [
            "cloud",
            "management"
          ],
          "ends": "Cloud → Management",
          "rides": "cloud management|management>cloud|Fetch update"
        },
        {
          "from": "bus",
          "to": "management",
          "text": "Nothing returns on a publish",
          "placed": [
            "bus",
            "management"
          ],
          "ends": "Bus → Management"
        },
        {
          "from": "management",
          "to": "linux",
          "text": "The config is applied",
          "placed": [
            "management",
            "linux"
          ],
          "ends": "Management → Linux",
          "rides": "linux management|management>linux|Apply config"
        }
      ]
    }
  ],
