{
  "name": "flowy-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source architecture docs you zoom through: a C4-style model in YAML, step-by-step flows, and an MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feluminais/flowy-docs.git"
  },
  "type": "module",
  "bin": {
    "flowy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p src/core && tsc -p ui",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && vite build ui && tsc -p tsconfig.build.json",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "build:vscode": "npm run build:ui && npm run build --prefix vscode",
    "package:vscode": "npm run build:ui && npm run package --prefix vscode",
    "lab:run": "node perf-lab/load/run.ts",
    "lab:smoke": "node --test perf-lab/test/smoke.test.ts",
    "bench": "node bench/views.ts && node bench/layout.ts && node bench/perf.ts && node bench/server.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:browser": "npm run build:ui && playwright test --config browser-tests/playwright.config.ts",
    "check:layers": "depcruise src ui/src --config .dependency-cruiser.cjs",
    "check:unused": "knip --no-progress"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "^0.0.83",
    "dependency-cruiser": "^18.7.0",
    "fast-check": "^4.10.2",
    "highlight.js": "^11.12.0",
    "knip": "^6.42.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rolldown": "^1.2.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
