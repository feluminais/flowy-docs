{
  "name": "flowy-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source architecture docs you zoom through: a C4-style model in YAML, step-by-step flows, and an MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feluminais/flowy-docs.git"
  },
  "type": "module",
  "bin": {
    "flowy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p src/core && tsc -p ui",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && vite build ui && tsc -p tsconfig.build.json",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "lab:run": "node perf-lab/load/run.ts",
    "lab:smoke": "node --test perf-lab/test/smoke.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
