{
  "name": "flowy-docs",
  "displayName": "Flowy Docs",
  "description": "Architecture docs you zoom through: open a repo's flowy/ folder as a diagram inside VS Code, play its flows, edit it, and jump between the diagram and the code.",
  "version": "0.1.0",
  "publisher": "feluminais",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feluminais/flowy-docs.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/feluminais/flowy-docs/issues"
  },
  "homepage": "https://github.com/feluminais/flowy-docs#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "documentation",
    "diagram",
    "c4",
    "yaml",
    "flowchart",
    "mcp",
    "ai"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2563eb",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/flowy/model.yaml",
    "onWebviewPanel:flowy.docs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flowy.open",
        "category": "Flowy",
        "title": "Open Docs"
      },
      {
        "command": "flowy.openFlow",
        "category": "Flowy",
        "title": "Open Flow…"
      },
      {
        "command": "flowy.goToShape",
        "category": "Flowy",
        "title": "Go to Shape…"
      },
      {
        "command": "flowy.showFile",
        "category": "Flowy",
        "title": "Show This File in the Docs"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flowy.openFlow",
          "when": "flowy.hasDocs"
        },
        {
          "command": "flowy.goToShape",
          "when": "flowy.hasDocs"
        },
        {
          "command": "flowy.showFile",
          "when": "flowy.hasDocs"
        }
      ],
      "explorer/context": [
        {
          "command": "flowy.showFile",
          "when": "flowy.hasDocs && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "flowy.showFile",
          "when": "flowy.hasDocs && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "flowy.showFile",
          "when": "flowy.hasDocs && resourceScheme == file",
          "group": "1_flowy"
        }
      ]
    }
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Flowy reads the flowy/ folder and the repo's git remote from disk."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Flowy runs git in the folder to find where code links go, and a repo can configure git to run programs."
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.ts --release",
    "build": "node build.ts",
    "typecheck": "tsc -p .",
    "package": "vsce package --no-dependencies --baseImagesUrl https://github.com/feluminais/flowy-docs/raw/HEAD/vscode"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
